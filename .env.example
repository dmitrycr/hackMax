# Local development only. Replace both values before exposing the application.
POSTGRES_USER=hackmax
POSTGRES_PASSWORD=local-hackmax-password
POSTGRES_DB=hackmax
PROCESSOR_TOKEN=local-processor-token-change-me
GATEWAY_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Optional echo bot. Start explicitly with make bot or make bot-local.
MAX_BOT_TOKEN=
# Temporary local workaround: true disables certificate verification for MAX only.
MAX_INSECURE_SKIP_VERIFY=false

# Optional: only the Go worker receives this key. Blank disables LLM requests.
# Use openrouter/free or a specific provider/model:free with structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=180s
OPENROUTER_MAX_TOKENS=8000
