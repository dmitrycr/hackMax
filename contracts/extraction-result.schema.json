{
  "$defs": {
    "ExtractedField": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Text"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalized Value"
        },
        "value_type": {
          "enum": [
            "text",
            "decimal",
            "date"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "extraction_method": {
          "enum": [
            "docx",
            "pdf_text",
            "ocr"
          ],
          "title": "Extraction Method",
          "type": "string"
        },
        "engine_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine Score"
        },
        "review_required": {
          "title": "Review Required",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "field_id",
        "raw_text",
        "normalized_value",
        "value_type",
        "extraction_method",
        "review_required"
      ],
      "title": "ExtractedField",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "docx",
            "pdf",
            "image"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "document_version_id": {
      "title": "Document Version Id",
      "type": "string"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "title": "Profile Version",
      "type": "string"
    },
    "processor_version": {
      "title": "Processor Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "unreadable"
      ],
      "title": "Status",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/ExtractedField"
      },
      "title": "Fields",
      "type": "array"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "document_version_id",
    "sha256",
    "profile_id",
    "profile_version",
    "processor_version",
    "status",
    "fields",
    "issues"
  ],
  "title": "ExtractionResult",
  "type": "object"
}
